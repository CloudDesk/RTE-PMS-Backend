NODE_ENV=development
PORT=5800
HOST=0.0.0.0
API_URL=http://localhost:5800
MONGODB_URI=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
COOKIE_SECRET=

# GCP storage
PROJECT_ID=cloud-desk-447206
