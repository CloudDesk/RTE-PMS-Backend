NODE_ENV=development
PORT=5800
HOST=0.0.0.0
API_URL=http://localhost:5800
MONGODB_URI=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
COOKIE_SECRET=

# GCP storage
PROJECT_ID=cloud-desk-447206
GCP_STORAGE_BUCKET=pms-sample

# PMS-only storage. Existing non-PMS uploads continue to use GCP_STORAGE_BUCKET.
PMS_STORAGE_PROVIDER=gcp
PMS_GCP_STORAGE_BUCKET=pms-sample

# Required only when PMS_STORAGE_PROVIDER=azure.
PMS_AZURE_STORAGE_ACCOUNT=
PMS_AZURE_STORAGE_CONTAINER=
PMS_AZURE_STORAGE_ENDPOINT=
PMS_AZURE_MANAGED_IDENTITY_CLIENT_ID=
PMS_AZURE_STORAGE_CONNECTION_STRING=
PMS_STORAGE_ALLOWED_HOSTS=

# Choose one credential approach:
# 1. Full JSON in one line
GCP_SERVICE_ACCOUNT_JSON=

# 2. Or split service-account fields
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Optional tuning
GCP_UPLOAD_TIMEOUT_MS=60000
GCP_RETRY_TOTAL_TIMEOUT_SEC=120
GCP_RETRY_MAX_RETRIES=2
GMAIL_TLS_REJECT_UNAUTHORIZED=true
